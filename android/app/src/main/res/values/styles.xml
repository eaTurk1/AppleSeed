<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppleSeedTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">#090a0c</item>
        <item name="android:statusBarColor">#090a0c</item>
        <item name="android:navigationBarColor">#090a0c</item>
        <item name="android:colorAccent">#ff3d52</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="AppleSeedLightTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">#f4f5f7</item>
        <item name="android:statusBarColor">#f4f5f7</item>
        <item name="android:navigationBarColor">#f4f5f7</item>
        <item name="android:colorAccent">#d9223b</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
